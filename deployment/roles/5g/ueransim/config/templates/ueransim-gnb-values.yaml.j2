{#
  ueransim-gnb-values.yaml.j2
  Generates Helm values override for ueransim gNB chart (free5gc)
#}
{%- macro resolve_sd(sd) -%}
  {%- if sd == 'EMPTY' -%}0xFFFFFF
  {%- else -%}0x{{ '%06x' | format(sd | int(base=16)) }}
  {%- endif -%}
{%- endmacro -%}
{% set multinode = (core_node_name is defined and ran_node_name is defined and core_node_name != ran_node_name) %}
{% set n3_master = synthran_topology.transport.workload_interfaces.ran.n3 if multinode else nic_interface %}

global:
  # Free5GC/UERANSIM uses the primary interface plus the AMF NGAP service for
  # N2. N3 uses the authoritative inter-host OVS transport when split.
  n2network:
    enabled: true
    masterIf: "{{ nic_interface }}"
    gatewayIP: ""
    excludeIP: ""
  n3network:
    enabled: true
    masterIf: "{{ n3_master }}"
    type: "{{ 'ovs' if multinode else 'ipvlan' }}"
    gatewayIP: ""
    excludeIP: ""

gnb:
  enabled: true

  n2if:
    ipAddress: 0.0.0.0
  n3if:
    ipAddress: {{ net.n3.gnb_ip }}

  amf:
    n2if:
      ipAddress: {{ net.n2.amf_ip }}
      port: {{ net.n2.amf_ngap_port }}
    service:
      ngap:
        enabled: true

  nodeName: "{{ ran_node_name }}"

  configuration: |-
    mcc: '{{ profile.plmn.mcc }}'
    mnc: '{{ profile.plmn.mnc }}'
    nci: '0x000000010'
    idLength: 32
    tac: {{ profile.plmn.tac | int }}
    slices:
{% for slice in profile.slices %}
      - sst: {{ slice.sst | int }}
        sd: {{ resolve_sd(slice.sd) }}
{% endfor %}
    ignoreStreamIds: true

ue:
  enabled: false
