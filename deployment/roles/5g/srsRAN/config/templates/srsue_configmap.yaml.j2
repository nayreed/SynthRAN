apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ '{{' }} include "srsran-ue.fullname" . {{ '}}' }}-{{ '{{' }} .Release.Name {{ '}}' }}-ue-config
  labels:
    {{ '{{-' }} include "srsran-ue.labels" . | nindent 4 {{ '}}' }}
data:
  start_ue.sh: |
    #!/bin/bash
    set -euo pipefail
    UE_NUMBER=${1:?UE number is required}
    CONSOLE_LOG="/var/log/ue${UE_NUMBER}.console.log"
    mkdir -p /var/log
    : > "$CONSOLE_LOG"
    echo "--- Starting UE ${UE_NUMBER} ---" >> "$CONSOLE_LOG"
    python3 /srsran/config/generate_ue_conf.py "$UE_NUMBER" /tmp/ >> "$CONSOLE_LOG" 2>&1
    echo "Starting srsUE ${UE_NUMBER}..." >> "$CONSOLE_LOG"
    /opt/srsRAN_4G/build/srsue/src/srsue "/tmp/ue_${UE_NUMBER}.conf" >> "$CONSOLE_LOG" 2>&1 &
    UE_PID=$!
    echo "Waiting for tun_srsue${UE_NUMBER}..." >> "$CONSOLE_LOG"
    for i in $(seq 1 50); do
      if ip -4 -o addr show dev "tun_srsue${UE_NUMBER}" >/dev/null 2>&1; then
        UE_IP=$(ip -4 -o addr show dev "tun_srsue${UE_NUMBER}" | awk '{print $4}' | head -1)
        if [ -n "$UE_IP" ]; then
          echo "tun_srsue${UE_NUMBER} UP: $UE_IP" >> "$CONSOLE_LOG"
          ip link set dev "tun_srsue${UE_NUMBER}" mtu 1400 || true
          break
        fi
      fi
      sleep 2
    done
    wait "$UE_PID"
  start_gnu.sh: |
{{ '{{' }} .Files.Get "files/start_gnu.sh" | indent 4 {{ '}}' }}
  multi_ue_scenario.py: |
{{ '{{' }} .Files.Get "files/multi_ue_scenario.py" | indent 4 {{ '}}' }}
  generate_ue_conf.py: |
    #!/usr/bin/env python3
    import argparse, os
    UE_CONFIGS = {
    {{ '{{-' }} range $i, $ue := .Values.ues {{ '}}' }}
      {{ '{{' }} add $i 1 {{ '}}' }}: {
        "imsi":      "{{ '{{' }} $ue.imsi {{ '}}' }}",
        "k":         "{{ '{{' }} $ue.k {{ '}}' }}",
        "opc":       "{{ '{{' }} $ue.opc {{ '}}' }}",
        "apn":       "{{ '{{' }} $ue.apn {{ '}}' }}",
        "sst":       "{{ '{{' }} $ue.sst {{ '}}' }}",
        "sd":        "{{ '{{' }} $ue.sd {{ '}}' }}",
        "ue_ip":     "{{ '{{' }} $ue.ueIp {{ '}}' }}",
        "gnb_ip":    "{{ '{{' }} $.Values.gnbIp {{ '}}' }}",
        "tx_port":   {{ '{{' }} $ue.zmqTxPort {{ '}}' }},
        "rx_port":   {{ '{{' }} $ue.zmqRxPort {{ '}}' }},
      },
    {{ '{{-' }} end {{ '}}' }}
    }
    UE_TEMPLATE = (
        "[rf]\n"
        "freq_offset = 0\n"
        "tx_gain = 80\n"
        "rx_gain = 40\n"
        "srate = 23.04e6\n"
        "nof_antennas = 1\n"
        "device_name = zmq\n"
        "device_args = tx_port={tx_port},rx_port={rx_port},base_srate=23.04e6\n"
        "[rat.eutra]\n"
        "nof_carriers = 0\n"
        "[rat.nr]\n"
        "bands = 3\n"
        "nof_carriers = 1\n"
        "max_nof_prb = 106\n"
        "nof_prb = 106\n"
        "dl_nr_arfcn = 368500\n"
        "ssb_nr_arfcn = 368410\n"
        "[log]\n"
        "all_level = info\n"
        "phy_lib_level = none\n"
        "all_hex_limit = 32\n"
        "filename = {log_file}\n"
        "file_max_size = 1000\n"
        "[usim]\n"
        "mode = soft\n"
        "algo = milenage\n"
        "opc  = {opc}\n"
        "k    = {k}\n"
        "imsi = {imsi}\n"
        "imei = 356938035643803\n"
        "[rrc]\n"
        "release = 15\n"
        "ue_category = 4\n"
        "[nas]\n"
        "apn = {apn}\n"
        "apn_protocol = ipv4\n"
        "{slicing}"
        "[gw]\n"
        "ip_devname = tun_srsue{ue_number}\n"
        "ip_netmask = 255.255.255.0\n"
        "[gui]\n"
        "enable = false\n"
    )
    def generate_ue_config(ue_number, output_directory):
        os.makedirs(output_directory, exist_ok=True)
        if ue_number not in UE_CONFIGS:
            raise SystemExit("No generated configuration for UE {}".format(ue_number))
        cfg = UE_CONFIGS[ue_number]
        slicing = (
            "[slicing]\n"
            "enable = true\n"
            "nssai-sst = {sst}\n"
        ).format(sst=int(cfg["sst"]))
        if cfg["sd"]:
            slicing += "nssai-sd = {}\n".format(int(cfg["sd"]))
        content = UE_TEMPLATE.format(
            tx_port="tcp://{}:{}".format(cfg['ue_ip'], cfg['tx_port']),
            rx_port="tcp://{}:{}".format(cfg['ue_ip'], cfg['rx_port']),
            log_file=os.path.join(output_directory, "ue{}.log".format(ue_number)),
            opc=cfg["opc"], k=cfg["k"],
            imsi=cfg["imsi"], apn=cfg["apn"], slicing=slicing,
            ue_number=ue_number,
        )
        path = os.path.join(output_directory, "ue_{}.conf".format(ue_number))
        with open(path, "w") as f:
            f.write(content)
        print("Wrote {}".format(path))
        return path
    if __name__ == "__main__":
        parser = argparse.ArgumentParser()
        parser.add_argument("ue_number", type=int)
        parser.add_argument("output_directory", type=str)
        args = parser.parse_args()
        generate_ue_config(args.ue_number, args.output_directory)
